# ==============================================================================
# CodeMem Configuration Environment Variables
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Graph Database Backend
# Options: 'memory' (zero-dependency in-process graph double) or 'falkordb' (authoritative container/instance)
GRAPH_BACKEND=memory

# FalkorDB Connection Settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=codemem

# Workspace / Scope Isolation
DEFAULT_WORKSPACE_ID=default

# Retrieval & Abstention Policy
# Scores range 0.0 to 1.0. If top candidate < threshold, system abstains.
MIN_CONFIDENCE_THRESHOLD=0.45
DEFAULT_TOP_K=5

# LLM Provider Configuration
# Options: 'deterministic' (100% offline default, no API keys required), 'gemini', 'openai', 'ollama'
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=

# Logging
LOG_LEVEL=INFO
